{
  "id": "jazz-swing",
  "name": "Jazz swing",
  "tempoRange": [100, 200],
  "defaultTempo": 140,

  "feel": {
    "subdivision": 8,
    "swing": 0.95
  },

  "instruments": ["drums", "bass", "comp"],
  "audioPack": "drums-vcsl",

  "energyLevels": {
    "1": { "instruments": ["drums"],                 "velocityRange": [0.28, 0.46] },
    "2": { "instruments": ["drums", "bass"],         "velocityRange": [0.36, 0.56] },
    "3": { "instruments": ["drums", "bass", "comp"], "velocityRange": [0.44, 0.68] },
    "4": { "instruments": ["drums", "bass", "comp"], "velocityRange": [0.54, 0.80] },
    "5": { "instruments": ["drums", "bass", "comp"], "velocityRange": [0.62, 0.90] }
  },

  "drumPatterns": [
    {
      "id": "spang-a-lang",
      "weight": 0.45,
      "minEnergy": 1,
      "grid": {
        "ride":     "x.Xxx.Xx",
        "pedalHat": "..x...x.",
        "kick":     "o.o.o.o."
      }
    },
    {
      "id": "spang-comp",
      "weight": 0.3,
      "minEnergy": 2,
      "grid": {
        "ride":     "x.Xxx.Xx",
        "pedalHat": "..x...x.",
        "kick":     "o.o.o.o.",
        "snare":    "...o...o"
      }
    },
    {
      "id": "spang-bombs",
      "weight": 0.25,
      "minEnergy": 3,
      "grid": {
        "ride":     "x.Xxx.Xx",
        "pedalHat": "..x...x.",
        "kick":     "o.o.o.ox",
        "snare":    ".o...o.."
      }
    }
  ],

  "fills": [
    {
      "id": "jazz-fill-triolets",
      "weight": 0.45,
      "minEnergy": 2,
      "beats": 1,
      "grid": { "snare": ".........oxX" }
    },
    {
      "id": "jazz-fill-toms",
      "weight": 0.3,
      "minEnergy": 3,
      "beats": 2,
      "grid": {
        "snare":  "......x.o...",
        "tomMid": ".........x..",
        "tomLow": "..........xX"
      }
    },
    {
      "id": "jazz-fill-kick-snare",
      "weight": 0.25,
      "minEnergy": 2,
      "beats": 1,
      "grid": { "snare": "......o.", "kick": ".......x" }
    }
  ],

  "humanize": {
    "offsets": {
      "kick": 2,
      "snare": 6,
      "hihat": 3,
      "ride": -2,
      "crash": -1,
      "tomMid": 4,
      "tomLow": 4
    },
    "jitterMs": 6,
    "velSigma": 0.06
  },

  "bassStyle": { "approach": "walking", "ghostNotes": true },
  "compStyle": { "instrument": "piano", "rhythm": "jazzComp", "voicing": "rootless", "register": [52, 72] }
}
