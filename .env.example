# Copier en .env.local (jamais commité — couvert par .gitignore)
#
# Ces deux valeurs sont PUBLIQUES par conception : elles partent dans le
# bundle JavaScript de tous les visiteurs. Ce qui protège réellement les
# données, c'est le Row Level Security côté Supabase — voir
# sql/01-rls-progress.sql, à exécuter AVANT toute mise en production.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# La clé service_role ne doit JAMAIS figurer ici ni dans aucun fichier
# préfixé VITE_ : elle contourne le RLS. Elle vit uniquement dans les
# variables d'environnement des Edge Functions Supabase.
